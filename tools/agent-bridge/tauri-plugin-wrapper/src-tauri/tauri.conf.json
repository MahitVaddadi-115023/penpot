{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Antigravity Bridge",
  "version": "0.1.0",
  "identifier": "com.antigravity.plugin-wrapper",
  "build": {
    "frontendDist": "../../agent-plugin"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Antigravity Bridge",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true,
        "focus": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: ipc: 'unsafe-inline' 'unsafe-eval' data: blob:; script-src 'self' tauri: 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://tauri.localhost http://localhost:3777 ws://localhost:3777 http://localhost:9010 ws://localhost:9010"
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
